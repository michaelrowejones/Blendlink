{
  "name": "blendlink-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:unit",
    "test:unit": "npm run test --workspaces --if-present && npm run test:release-policy",
    "test:release-policy": "node --test scripts/source-hygiene.test.mjs scripts/production-audit-policy.test.mjs scripts/package-license-contract.test.mjs scripts/verify-retained-release.test.mjs scripts/release-workflow-policy.test.mjs",
    "audit:production": "node scripts/verify-production-audit.mjs",
    "test:consumer": "npm run build && node scripts/test-consumer-builds.mjs",
    "test:examples": "npm run build && node scripts/test-examples.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs && node scripts/test-dogfood-package-identity.mjs",
    "dogfood:package": "npm run build && node scripts/prepare-dogfood-package.mjs",
    "test:addon-headless": "npm run build && node scripts/test-addon-headless.mjs",
    "test:baked-e2e": "npm run build && node scripts/test-baked-e2e.mjs",
    "test:real-tools": "npm run build && node scripts/test-real-toolchains.mjs",
    "verify:needle-baseline": "node scripts/verify-needle-baseline.mjs",
    "test:contact-shadows-differential-browser": "npm run build && node experiments/contact-shadows-differential-browser/run.mjs",
    "test:ground-projection-browser": "npm run build && node experiments/ground-projection-browser/run.mjs",
    "test:ground-projection-resolution-browser": "node experiments/ground-projection-resolution-browser/run.mjs",
    "test:reflection-probe-browser": "npm run build && node experiments/reflection-probe-browser-evidence/run.mjs",
    "test:animation-deformation-browser": "npm run build && node experiments/animation-deformation-browser/run.mjs",
    "test:needle-animation-runtime": "node experiments/needle-animation-runtime-differential/run.mjs",
    "test:r3f-animation-transport-browser": "node experiments/r3f-animation-transport-browser/run.mjs",
    "test:r3f-orbit-demand-browser": "node experiments/r3f-orbit-demand-browser/run.mjs",
    "test:r3f-missing-companion-browser": "npm run build && node experiments/r3f-missing-companion-browser/run.mjs",
    "test:fixed-camera-surface-browser": "npm run build --workspace blendlink && node experiments/fixed-camera-surface-browser/run.mjs",
    "test:static-shade-floor-browser": "node experiments/static-shade-floor-browser/run.mjs",
    "test:graph-deployment-browser": "node experiments/graph-deployment-browser-gate/run.mjs",
    "test:wgpu-postprocessing-parity": "node experiments/wgpu-postprocessing-parity/run.mjs",
    "test:wgpu-node-postprocessing": "node experiments/wgpu-postprocessing-parity/node-run.mjs",
    "test:tsl-node-differential": "node experiments/tsl-node-differential/run.mjs",
    "test:full": "npm run build && npm run test:unit && node scripts/test-real-toolchains.mjs && node scripts/test-consumer-builds.mjs && node scripts/test-examples.mjs && node scripts/test-package.mjs && node scripts/test-dogfood-package-identity.mjs && node scripts/test-addon-headless.mjs && node scripts/test-baked-e2e.mjs",
    "release:artifacts": "npm run audit:production && npm run build && node scripts/build-release-artifacts.mjs",
    "prototype:eevee-materializer": "node experiments/eevee-uv-materializer-prototype/run.mjs",
    "prototype:r3f-atomic-presentation": "node experiments/r3f-atomic-presentation-prototype/run.mjs",
    "prototype:content-addressed-bundle": "node --test experiments/content-addressed-bundle-prototype/publisher.test.mjs"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.184.0",
    "n8ao-webgpu": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.184.0"
  },
  "overrides": {
    "n8ao-webgpu": {
      "three": "$three"
    }
  }
}
