+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Bounded original-color BOX transport; normal composition stays refused."""
+import platform,sys,struct
+import bpy
+MODEL='eevee-metal-box-color-mips-v1'
+BLEND=0.09966777265071869
+
+def emit(node,socket,stack,*,engine,allow_refs,emit_vector,refuse):
+    if not allow_refs:refuse('Image BOX blend currently needs the qualified external color transport')
+    if bpy.app.version!=(5,3,0) or bpy.app.build_hash!=b'02f0899d78e3' or engine!='EEVEE' or sys.platform!='darwin' or platform.machine()!='arm64' or bpy.context.preferences.system.gpu_backend!='METAL':
+        refuse('Image blended BOX color currently needs the qualified Blender5.3 Metal EEVEE source profile')
+    image=node.image
+    if socket.name!='Color':refuse('Image blended BOX Alpha has no qualified transport yet')
+    if node.projection_blend!=BLEND or node.interpolation!='Linear' or node.extension!='REPEAT':
+        refuse('Image blended BOX color currently needs blend0.09966777265071869, Linear and Repeat')
+    if bpy.context.scene.render.use_high_quality_normals or bpy.context.scene.render.anisotropic_filter!='FILTER_2':
+        refuse('Image blended BOX color currently needs native SNORM10 normals and anisotropy2')
+    if image is None or tuple(image.size)!=(1024,1024) or image.is_float or image.source!='FILE' or image.file_format!='PNG' or image.colorspace_settings.name!='sRGB' or image.alpha_mode!='STRAIGHT':
+        refuse('Image blended BOX color currently needs an opaque1024-square byte sRGB PNG with straight alpha')
+    if image.is_dirty:refuse('Image blended BOX needs saved source pixels; save the image changes before export')
+    try:
+        if image.packed_file:header=bytes(image.packed_file.data)[:33]
+        else:
+            with open(bpy.path.abspath(image.filepath),'rb') as handle:header=handle.read(33)
+    except OSError as error:refuse('Image blended BOX source PNG is unavailable: '+str(error))
+    if len(header)!=33 or header[:8]!=b'\x89PNG\r\n\x1a\n' or header[12:16]!=b'IHDR' or struct.unpack('>II',header[16:24])!=(1024,1024) or header[24:29]!=bytes((8,2,0,0,0)):
+        refuse('Image blended BOX currently needs actual opaque noninterlaced RGB8 PNG bytes')
+    if not node.inputs['Vector'].is_linked:refuse('Image blended BOX color currently needs an explicit supported vector input')
+    if __package__:
+        from .geometry_ir import primary_context
+    else:
+        from geometry_ir import primary_context
+    return {'op':'texture_box_ref','model':MODEL,'sourceEngine':'EEVEE','projection':'BOX','box':{'schemaVersion':1,'model':MODEL,'blend':BLEND,'normal':primary_context('object-normal','EEVEE')},
+            'ref':{'image':image.name,'interpolation':'Linear','extension':'REPEAT','samplingModel':MODEL},
+            'image':{'name':image.name,'width':1024,'height':1024,'colorSpace':'sRGB'},'interpolation':'Linear','extension':'REPEAT','output':'color',
+            'vector':emit_vector(node.inputs['Vector'],stack=stack,as_vector=True)}
+
+
+def requires(value):
+    if isinstance(value,dict):
+        return value.get('op')=='texture_box_ref' or any(requires(child) for child in value.values())
+    return isinstance(value,(tuple,list)) and any(requires(child) for child in value)
+
+
+def validate_channels(entries,tree=None):
+    if not requires(entries):return
+    if any(entry.get('channel')!='Base Color' and requires(entry.get('tslIr')) for entry in entries):
+        raise ValueError('Blended BOX currently qualifies the Base Color channel only; other material channels need their own composition proof')
+    if tree is not None:
+        if __package__:
+            from . import tsl_ir
+        else:
+            import tsl_ir
+        try:root,stack=tsl_ir.find_principled_root(tree,target='EEVEE')
+        except tsl_ir.TslIrRefusal as error:raise ValueError('Blended BOX color currently needs one direct Principled surface') from error
+        if stack or root.id_data!=tree:raise ValueError('Blended BOX color currently needs a direct ungrouped Principled surface')
+    channels={entry.get('channel'):entry.get('tslIr') for entry in entries}
+    if any(not channels.get(name) for name in ('Base Color','Metallic','Roughness','Emission','Alpha')) or any(entry.get('tslIrRefusal') or not entry.get('tslIr') for entry in entries):
+        raise ValueError('Blended BOX color needs complete Base Color, Metallic, Roughness, Emission and Alpha programs with no source refusals')
+    alpha=(channels.get('Alpha') or {}).get('output') or {}
+    if not channels.get('Base Color') or alpha.get('op')!='const_float' or type(alpha.get('value')) not in (int,float) or alpha['value']!=1:
+        raise ValueError('Blended BOX color currently needs its complete Base Color and direct opaque Alpha1; fractional or linked Alpha needs a separate port')
+
+
+def prepare_carrier(material,channel_plan):
+    entries=(channel_plan or {}).get('channels') or []
+    if not requires(entries):return
+    validate_channels(entries,material.node_tree)
+    if __package__:
+        from . import tsl_ir
+    else:
+        import tsl_ir
+    root,stack=tsl_ir.find_principled_root(material.node_tree,target='EEVEE')
+    if stack or root.id_data!=material.node_tree:raise ValueError('Cannot privately neutralize a shared/group BOX material surface')
+    # Only this transaction-created Material/node tree is changed. The live
+    # sidecar owns Base Color; Blender stock export must not emit texCoord=-1
+    # for unsupported BOX projection on a primitive without texture UVs.
+    for name,value in [('Base Color',(1.,1.,1.,1.)),('Alpha',1.)]:
+        socket=root.inputs[name]
+        for link in list(socket.links):material.node_tree.links.remove(link)
+        socket.default_value=value
