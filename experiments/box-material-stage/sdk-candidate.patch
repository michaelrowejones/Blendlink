+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Capture immutable native image storage with public background GPU APIs.
+
+This is asset preparation, with zero render calls or material/lighting bake.
+No native implementation kernel is transcribed into the browser runtime.
+"""
+import hashlib,struct,zlib
+import bpy
+MODEL='eevee-metal-box-color-mips-v1'
+
+def _sha(data):return hashlib.sha256(data).hexdigest()
+
+def requirements(value,result):
+    if isinstance(value,dict):
+        if value.get('op')=='texture_box_ref' and value.get('projection')=='BOX':
+            name=(value.get('ref')or{}).get('image');model=(value.get('box')or{}).get('model')
+            if not isinstance(name,str) or model!=MODEL:raise ValueError('BOX image transport has invalid model/image ownership')
+            result.add(name)
+        for child in value.values():requirements(child,result)
+    elif isinstance(value,(list,tuple)):
+        for child in value:requirements(child,result)
+
+def capture(image,payload,cache=None):
+    if bpy.app.version!=(5,3,0) or bpy.app.build_hash!=b'02f0899d78e3':raise ValueError('Native BOX mip source build changed; requalify the image route')
+    if bpy.context.preferences.system.gpu_backend!='METAL':raise ValueError('Native BOX mip preparation requires its qualified Metal source profile')
+    if not bpy.app.background:raise ValueError('Native BOX mip preparation belongs to the disposable export worker')
+    # Reject alpha/profile/source variants before GPU allocation. Byte PNG RGB
+    # is opaque; the independent compiler audit checks its decoded base SHA.
+    if payload[:8]!=b'\x89PNG\r\n\x1a\n' or payload[12:16]!=b'IHDR' or len(payload)<33:
+        raise ValueError('BOX image mip transport needs actual RGB8 PNG source bytes')
+    width,height=struct.unpack('>II',payload[16:24])
+    if (width,height)!=(1024,1024) or payload[24:29]!=bytes((8,2,0,0,0)):
+        raise ValueError('BOX image mip transport needs noninterlaced1024-square RGB8 PNG bytes')
+    if tuple(image.size)!=(width,height) or image.is_float or image.alpha_mode!='STRAIGHT' or image.colorspace_settings.name!='sRGB' or image.is_dirty or image.source!='FILE' or image.file_format!='PNG':
+        raise ValueError('BOX image mip transport source metadata changed before publication')
+    key=(_sha(payload),MODEL,'5.3.0/02f0899d78e3/METAL/SRGB8_A8/paired-native')
+    if cache is not None and key in cache:
+        compressed,metadata=cache[key]
+        return compressed,dict(metadata)
+    import gpu,numpy as np
+    from gpu_extras.batch import batch_for_shader
+    gpu.init()
+    if gpu.platform.backend_type_get()!='METAL':raise ValueError('BOX image mip transport requires the qualified native Metal backend')
+    native=gpu.texture.from_image(image)
+    if native.format!='SRGB8_A8':raise ValueError('BOX image mip transport native storage is not SRGB8_A8')
+    info=gpu.types.GPUShaderCreateInfo();info.vertex_in(0,'VEC2','pos');info.fragment_out(0,'VEC4','fragColor');info.sampler(0,'FLOAT_2D','sourceTex');info.push_constant('VEC4','levelInfo')
+    info.vertex_source('void main(){gl_Position=vec4(pos,0.0,1.0);}')
+    info.fragment_source('void main(){fragColor=textureLod(sourceTex,gl_FragCoord.xy/levelInfo.y,levelInfo.x);}')
+    shader=gpu.shader.create_from_info(info);batch=batch_for_shader(shader,'TRI_FAN',{'pos':[(-1,-1),(1,-1),(1,1),(-1,1)]})
+    previous=gpu.state.viewport_get();blend=gpu.state.blend_get();depth=gpu.state.depth_test_get();levels=[];data=[]
+    try:
+        for level in range(11):
+            extent=1024>>level;target=gpu.types.GPUTexture((extent,extent),format='SRGB8_A8');frame=gpu.types.GPUFrameBuffer(color_slots=[target])
+            try:
+                with frame.bind():
+                    gpu.state.viewport_set(0,0,extent,extent);gpu.state.blend_set('NONE');gpu.state.depth_test_set('NONE');shader.bind();shader.uniform_sampler('sourceTex',native);shader.uniform_float('levelInfo',[level,extent,0,0]);batch.draw(shader)
+                    values=np.asarray(frame.read_color(0,0,extent,extent,4,0,'UBYTE'),np.uint8).copy();raw=values.tobytes()
+                if len(raw)!=extent*extent*4 or not np.all(values[:,:,3]==255):raise ValueError('BOX image mip transport requires opaque complete RGBA8 storage')
+                levels.append({'level':level,'width':extent,'height':extent,'sha256':_sha(raw)})
+                if level:data.append(raw)
+            finally:frame=None;target=None
+    finally:
+        gpu.state.viewport_set(*previous);gpu.state.blend_set(blend);gpu.state.depth_test_set(depth)
+    raw=b''.join(data)
+    if len(raw)!=1398100:raise ValueError('BOX mip chain exceeds its fixed byte/layout budget')
+    compressed=zlib.compress(raw,9)
+    metadata={'schemaVersion':1,'model':MODEL,'nativeVersion':'5.3.0','nativeBuild':'02f0899d78e3','nativeBackend':'METAL','sourceSha256':_sha(payload),'decodedRgbaSha256':levels[0]['sha256'],'uncompressedBytes':len(raw),'sha256':_sha(compressed),'bytes':len(compressed),'levels':levels[1:]}
+
+    if cache is not None:cache[key]=(compressed,metadata)
+    return compressed,dict(metadata)
