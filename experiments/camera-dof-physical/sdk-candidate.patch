+import {abs,clamp,float,select} from 'three/tsl'
+import type {TslEffectNode} from './tslPostEffects.js'
+
+/** Full physical pixel units, including endpoint asymmetry of the overlapping
+ * slight-focus near/far fields. Scalar equations only; no native ring code. */
+export function buildSourceCameraDofLayerWeights(radius:TslEffectNode){
+  const slight=clamp(float(5).sub(abs(radius)),0,1)
+  return{
+    foreground:clamp(radius.negate().sub(2.5),0,1),
+    background:clamp(radius.sub(3),0,1),
+    slightForeground:select(radius.lessThanEqual(0.5),slight,0),
+    slightBackground:select(radius.greaterThan(-0.5),slight,0),
+    focus:radius.abs().lessThanEqual(0.5),
+  }
+}
+export function buildSourceCameraDofDiskIntersection(radius:TslEffectNode,distance:TslEffectNode):TslEffectNode{
+  return clamp(radius.abs().sub(distance).add(0.5),0,1)
+}
