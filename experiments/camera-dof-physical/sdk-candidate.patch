index 0000000..d9ff049
--- /dev/null
+++ b/packages/blendlink/src/tslSourceCameraDof.ts
@@ -0,0 +1,181 @@
+import * as THREE from 'three'
+import { Fn, Loop, clamp, convertToTexture, float, max, mix, smoothstep, step, floor, ivec2, rtt, select,
+  uniform, uniformArray, uv, vec2, vec3, vec4 } from 'three/tsl'
+import { SOURCE_CAMERA_DOF_SAMPLING, validateSourceCameraDof,
+  type SourceCameraDepthOfField } from './sourceCameraDof.js'
+import type { TslEffectNode } from './tslPostEffects.js'
+import { buildSourceCameraDofLayerWeights as layerWeights, buildSourceCameraDofDiskIntersection as diskIntersection } from './tslSourceCameraDofLayers.js'
+import { OwnedCompositorRtt } from './tslCompositorRttOwner.js'
+import { CAMERA_DOF_TILE_PIXELS as TILE, CAMERA_DOF_GATHER_RADIUS_ERROR as RADIUS_ERROR, cameraDofTileExtent } from './sourceCameraDofCoverage.js'
+
+export function buildSourceCameraCoC(source: SourceCameraDepthOfField, positiveDepth: TslEffectNode,
+  outputWidth: TslEffectNode): TslEffectNode {
+  const focus=source.focusDistanceBlenderUnits
+  const biasPerPixel=source.apertureRadiusBlenderUnits*source.projection[0]/(2*focus)
+  return clamp(float(1).sub(float(focus).div(max(positiveDepth,1e-5))).mul(outputWidth).mul(biasPerPixel),
+    -source.maxCircleOfConfusionRadiusPixels,source.maxCircleOfConfusionRadiusPixels)
+}
+
+/** Native-derived tile bounds + separate near/far full-resolution gathers.
+ * The CoC and tile radius propagation are source-derived; this color/coverage
+ * sampler remains an unqualified approximation, not EEVEE scatter/resolve. */
+export function buildSourceCameraDof(source: SourceCameraDepthOfField,
+  color: TslEffectNode, positiveDepth: TslEffectNode) {
+  validateSourceCameraDof(source)
+  const beauty = convertToTexture(color)
+  const targetOptions={type:THREE.FloatType,depthBuffer:false} as Parameters<typeof rtt>[3]
+  const depth = convertToTexture(positiveDepth, null, null, targetOptions)
+  const resources: OwnedCompositorRtt[] = []
+  if(beauty !== color && (beauty as TslEffectNode).isRTTNode)resources.push(new OwnedCompositorRtt(beauty))
+  if(depth !== positiveDepth && (depth as TslEffectNode).isRTTNode)resources.push(new OwnedCompositorRtt(depth))
+  const extent = uniform(new THREE.Vector2(...source.renderExtent))
+  const tileExtent=uniform(new THREE.Vector2(...cameraDofTileExtent(...source.renderExtent)))
+  const points = (count:number) => uniformArray(Array.from({ length:count }, (_,i)=> {
+    const angle=i*Math.PI*(3-Math.sqrt(5)),radius=Math.sqrt((i+0.5)/count)
+    return new THREE.Vector2(Math.cos(angle)*radius,Math.sin(angle)*radius)
+  }))
+  const farPoints=points(64),nearPoints=points(128),slightPoints=points(16)
+  const coc = (z:TslEffectNode):TslEffectNode => buildSourceCameraCoC(source,z,extent.x)
+  // Every physical depth pixel contributes to its bound: 256 reads per tile,
+  // not one decimated depth sample that could omit a thin foreground object.
+  const reduced=rtt(Fn(()=>{
+    const origin=floor(uv().mul(tileExtent)).mul(TILE)
+    const bound=float(0).toVar()
+    Loop(TILE*TILE,({i})=>{
+      const index:TslEffectNode=float(i)
+      const position=origin.add(vec2(index.mod(TILE),floor(index.div(TILE))))
+      const z=depth.load(ivec2(clamp(position,vec2(0),extent.sub(1)))).r
+      bound.assign(max(bound,coc(z).negate()))
+    })
+    return vec4(bound,0,0,1)
+  })(),tileExtent.value.x,tileExtent.value.y,targetOptions)
+  resources.push(new OwnedCompositorRtt(reduced))
+  const reach=Math.ceil(source.maxCircleOfConfusionRadiusPixels*RADIUS_ERROR/TILE),span=reach*2+1
+  const dilated=rtt(Fn(()=>{
+    const center=floor(uv().mul(tileExtent)),bound=float(0).toVar()
+    Loop(span*span,({i})=>{
+      const index:TslEffectNode=float(i)
+      const offset=vec2(index.mod(span),floor(index.div(span))).sub(reach)
+      const position=clamp(center.add(offset),vec2(0),tileExtent.sub(1))
+      const radius=reduced.load(ivec2(position)).r
+      const closestDistance=max(offset.abs().sub(1),vec2(0)).length().mul(TILE)
+      bound.assign(max(bound,select(radius.mul(RADIUS_ERROR).greaterThan(closestDistance),radius,0)))
+    })
+    return vec4(bound,0,0,1)
+  })(),tileExtent.value.x,tileExtent.value.y,targetOptions)
+  resources.push(new OwnedCompositorRtt(dilated))
+  const node=Fn(()=>{
+    const coordinate=uv(),center=beauty.sample(coordinate).toVar()
+    const centerRadius=coc(depth.sample(coordinate).r).toVar()
+    const nearRadius=dilated.load(ivec2(floor(coordinate.mul(tileExtent)))).r.toVar()
+    const centerLayers=layerWeights(centerRadius)
+    const farRadius=select(centerLayers.foreground.greaterThan(0),nearRadius,max(centerRadius,0)).toVar()
+    const farWeight=centerLayers.background.toVar(),farColor=center.rgb.mul(farWeight).toVar()
+    const holeWeight=centerLayers.foreground.oneMinus().toVar(),holeColor=center.rgb.mul(holeWeight).toVar()
+    // Hole reconstruction stays approximate. Far eligibility now uses the
+    // native source range; it no longer captures the slight-focus field.
+    Loop(64,({i})=>{
+      const disk:TslEffectNode=farPoints.element(i)
+      const position=clamp(coordinate.add(disk.mul(farRadius).div(extent)),vec2(0),vec2(1))
+      const weights=layerWeights(coc(depth.sample(position).r)),sample=beauty.sample(position).rgb
+      farColor.addAssign(sample.mul(weights.background));farWeight.addAssign(weights.background)
+      const hole=weights.foreground.oneMinus()
+      holeColor.addAssign(sample.mul(hole));holeWeight.addAssign(hole)
+    })
+    const foreground=vec3(0).toVar(),foregroundWeight=float(0).toVar()
+    Loop(128,({i})=>{
+      const disk:TslEffectNode=nearPoints.element(i)
+      const position=clamp(coordinate.add(disk.mul(nearRadius).div(extent)),vec2(0),vec2(1))
+      const sampleRadius=coc(depth.sample(position).r),distance=disk.length().mul(nearRadius)
+      const coverage=diskIntersection(sampleRadius,distance).mul(layerWeights(sampleRadius).foreground)
+      const weight=coverage.div(max(sampleRadius.mul(sampleRadius),1))
+      foreground.addAssign(beauty.sample(position).rgb.mul(weight));foregroundWeight.addAssign(weight)
+    })
+    // Independent fixed worst-case 16 symmetric disk pairs + center at the
+    // source's maximum slight-focus search radius 5. No ring occlusion is
+    // claimed. Scalars/layer ordering match the source; coverage is estimated.
+    const inverseArea=float(1).div(max(centerRadius.mul(centerRadius),1))
+    const slightNearWeight=centerLayers.slightForeground.mul(inverseArea).toVar()
+    const slightNearColor=center.rgb.mul(slightNearWeight).toVar()
+    const slightFarWeight=centerLayers.slightBackground.mul(inverseArea).toVar()
+    const slightFarColor=center.rgb.mul(slightFarWeight).toVar()
+    const slightFarOpacity=centerLayers.slightBackground.toVar()
+    Loop(16,({i})=>{
+      const disk:TslEffectNode=slightPoints.element(i)
+      Loop(2,({i:pair})=>{
+        const offset=disk.mul(5).mul(float(pair).mul(2).sub(1))
+        const position=clamp(coordinate.add(offset.div(extent)),vec2(0),vec2(1))
+        const sampleRadius=coc(depth.sample(position).r),weights=layerWeights(sampleRadius)
+        const intersection=diskIntersection(sampleRadius,offset.length())
+        const sampleWeight=intersection.div(max(sampleRadius.mul(sampleRadius),1))
+        const sample=beauty.sample(position).rgb,nearWeight=sampleWeight.mul(weights.slightForeground)
+        const farWeight=sampleWeight.mul(weights.slightBackground)
+        slightNearColor.addAssign(sample.mul(nearWeight));slightNearWeight.addAssign(nearWeight)
+        slightFarColor.addAssign(sample.mul(farWeight));slightFarWeight.addAssign(farWeight)
+        slightFarOpacity.addAssign(weights.slightBackground)
+      })
+    })
+    const hole=select(holeWeight.greaterThan(0),holeColor.div(max(holeWeight,1e-8)),center.rgb)
+    const far=select(farWeight.greaterThan(0),farColor.div(max(farWeight,1e-8)),hole)
+    const slightBGCoverage=clamp(slightFarOpacity.div(33),0,1)
+    const slightBG=slightFarColor.div(max(slightFarWeight,1e-8)).mul(slightBGCoverage)
+    const slightNearCoverage=clamp(slightNearWeight.mul(25/33),0,1)
+    const slightFG=slightNearColor.div(max(slightNearWeight,1e-8)).mul(slightNearCoverage)
+    // Exact focus restores the unfiltered center before neighboring foreground
+    // coverage is overlaid. All layer colors below are premultiplied once.
+    const underneath=select(centerLayers.focus,center.rgb,far.mul(slightBGCoverage.oneMinus()).add(slightBG))
+    const slight=underneath.mul(slightNearCoverage.oneMinus()).add(slightFG)
+    const near=foreground.div(max(foregroundWeight,1e-8))
+    const coverage=clamp(foregroundWeight.mul(nearRadius.mul(nearRadius)).div(128),0,1)
+    return vec4(slight.mul(coverage.oneMinus()).add(near.mul(coverage)),center.a)
+  })()
+  let disposed=false
+  return{node,sampling:SOURCE_CAMERA_DOF_SAMPLING,
+    setExtent(width:number,height:number){
+      extent.value.set(width,height)
+      const dimensions=cameraDofTileExtent(width,height)
+      if(tileExtent.value.x!==dimensions[0]||tileExtent.value.y!==dimensions[1]){
+        tileExtent.value.set(...dimensions);reduced.setSize(...dimensions);dilated.setSize(...dimensions)
+      }
+    },
+    dispose(){if(disposed)return;disposed=true;for(const owner of resources.reverse())owner.dispose()},
+  }
+}
+
+/** Refuse camera replacement, resizing to another aspect, and transparent
+ * routes. Called before installation and each frame; there is no fallback
+ * from an explicit experimental request to a silently sharp image. */
+export function validateSourceCameraDofScene(source: SourceCameraDepthOfField,
+  scene: THREE.Scene, camera: THREE.Camera, width: number, height: number): void {
+  validateSourceCameraDof(source)
+  const fail = (reason: string): never => { throw new Error(`Experimental Blender camera DOF: ${reason}.`) }
+  if (!(camera as THREE.PerspectiveCamera).isPerspectiveCamera || camera.name !== source.camera)
+    fail('active camera differs from the authored perspective camera')
+  if (!Number.isInteger(width) || !Number.isInteger(height) || width <= 0 || height <= 0
+    || Math.abs(width/height-source.renderExtent[0]/source.renderExtent[1]) > 1e-5)
+    fail('physical output extent must retain the authored aspect ratio')
+  const close = (a: number,b: number) => Math.abs(a-b) <= 5e-5*Math.max(1,Math.abs(b))
+  const perspective = camera as THREE.PerspectiveCamera
+  if (!close(perspective.near, source.clipNear) || !close(perspective.far, source.clipFar))
+    fail('active camera clip planes differ from the source')
+  camera.updateWorldMatrix(true, false)
+  for(let row=0;row<4;row++) for(let column=0;column<4;column++) {
+    // WebGPU renderer changes projection Z for its backend. Optical x/y/w
+    // rows must still match; near/far have their own explicit check above.
+    if (row !== 2 && !close(camera.projectionMatrix.elements[column*4+row],source.projection[row*4+column]))
+      fail('active camera projection differs from the source')
+    if (!close(camera.matrixWorld.elements[column*4+row],source.cameraWorldGltf[row*4+column]))
+      fail('active camera transform differs from the fixed authored camera')
+  }
+  if (scene.overrideMaterial) fail('an application material override is outside the opaque candidate')
+  scene.traverseVisible(object=>{
+    const material = (object as THREE.Mesh).material
+    if (!material) return
+    for(const entry of Array.isArray(material)?material:[material]) {
+      const physical = entry as THREE.MeshPhysicalMaterial
+      if (entry.transparent || entry.opacity !== 1 || entry.alphaTest > 0 || entry.alphaHash
+        || (physical.transmission ?? 0)>0 || entry.depthWrite === false)
+        fail(`material ${entry.name || entry.uuid} is outside the opaque depth contract`)
+    }
+  })
+}
