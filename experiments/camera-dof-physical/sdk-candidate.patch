index 6b0c061..4df3bdd 100644
--- a/packages/blender-addon/camera_fidelity.py
+++ b/packages/blender-addon/camera_fidelity.py
@@ -2 +2,81 @@
-"""Read-only warnings for authored camera optics without a web translation."""
+"""Read-only camera optics evidence; extraction does not qualify a web renderer."""
+
+import math
+
+
+def extract_depth_of_field(scene, depsgraph=None):
+    """EEVEE 02f0899d78e3 perspective CoC inputs, with a frozen camera contract.
+
+    The native aperture is lens * .001 / (2*fstop), in Blender scene units:
+    EEVEE does not multiply it by unit_settings.scale_length. Its projected
+    radius at the focus plane gives CoC bias; CoC(z) = bias*(1-focus/z).
+    This transports evaluated data, not an EEVEE gather/scatter port.
+    """
+    camera = scene.camera
+    if camera is None or camera.type != 'CAMERA' or not camera.data.dof.use_dof:
+        return None
+    import bpy
+    from mathutils import Matrix
+    depsgraph = depsgraph or bpy.context.evaluated_depsgraph_get()
+    evaluated = camera.evaluated_get(depsgraph)
+    data = evaluated.data
+    dof = data.dof
+    render = scene.render
+    width = max(1, int(render.resolution_x * render.resolution_percentage / 100))
+    height = max(1, int(render.resolution_y * render.resolution_percentage / 100))
+    projection = evaluated.calc_matrix_camera(depsgraph, x=width, y=height,
+        scale_x=render.pixel_aspect_x, scale_y=render.pixel_aspect_y)
+    target = dof.focus_object
+    focus = max(float(dof.focus_distance), 1e-5)
+    if target is not None:
+        target = target.evaluated_get(depsgraph)
+        position = target.matrix_world.translation
+        bone = target.pose.bones.get(dof.focus_subtarget) if target.pose else None
+        if bone is not None:
+            position = (target.matrix_world @ bone.matrix).translation
+        axis = evaluated.matrix_world.col[2].to_3d().normalized()
+        focus = max(abs(axis.dot(evaluated.matrix_world.translation-position)), 1e-5)
+    aperture = float(data.lens) * 1e-3 / (2 * max(float(dof.aperture_fstop), 1e-5))
+    reasons = []
+    if data.type != 'PERSP': reasons.append('Only perspective camera optics are modeled')
+    if scene.render.engine != 'BLENDER_EEVEE': reasons.append('Only the pinned EEVEE optics are modeled')
+    if target is not None: reasons.append('Object/bone focus tracking is not qualified')
+    if dof.aperture_blades != 0: reasons.append('Polygonal aperture is not qualified')
+    if abs(dof.aperture_ratio-1) > 1e-6: reasons.append('Anamorphic aperture is not qualified')
+    if render.pixel_aspect_x != render.pixel_aspect_y: reasons.append('Nonsquare pixels are not qualified')
+    if render.use_border: reasons.append('Render borders are not qualified')
+    if scene.eevee.use_bokeh_jittered: reasons.append('Native jittered aperture is not qualified')
+    if scene.unit_settings.scale_length != 1: reasons.append('Nonunit glTF scene scale is not qualified')
+    if len(camera.constraints): reasons.append('Camera constraints are not qualified')
+    for owner in (scene, camera, camera.data):
+        animation = owner.animation_data
+        if animation and (animation.action or len(animation.drivers) or len(animation.nla_tracks)):
+            reasons.append('Animated camera/scene optics are not qualified')
+            break
+    if not all(math.isfinite(v) and v > 0 for v in (aperture, focus, data.clip_start, data.clip_end)):
+        reasons.append('Nonfinite or nonpositive camera optics')
+    # glTF's exporter changes global Z-up into Y-up, retaining camera-local axes.
+    world = Matrix.Rotation(-math.pi/2, 4, 'X') @ evaluated.matrix_world
+    return {
+        'version': 1, 'model': 'eevee-perspective-coc-v1',
+        'qualification': 'experimental-unqualified', 'automaticEnabled': False,
+        'camera': camera.name, 'frame': scene.frame_current,
+        'nativeVersion': list(bpy.app.version), 'nativeBuild': bpy.app.build_hash.decode(),
+        'cameraType': data.type, 'lensMillimeters': float(data.lens),
+        'sensorFit': data.sensor_fit, 'sensorWidthMillimeters': float(data.sensor_width),
+        'sensorHeightMillimeters': float(data.sensor_height),
+        'apertureFStop': float(dof.aperture_fstop), 'apertureRadiusBlenderUnits': aperture,
+        'apertureBlades': int(dof.aperture_blades),
+        'apertureRotationRadians': float(dof.aperture_rotation),
+        'apertureRatio': float(dof.aperture_ratio),
+        'focusDistanceBlenderUnits': focus, 'focusObject': target.name if target else None,
+        'focusBone': dof.focus_subtarget,
+        'clipNear': float(data.clip_start), 'clipFar': float(data.clip_end),
+        'projection': [float(v) for row in projection for v in row],
+        'cameraWorldGltf': [float(v) for row in world for v in row],
+        'renderExtent': [width, height],
+        'pixelAspect': [float(render.pixel_aspect_x), float(render.pixel_aspect_y)],
+        'maxCircleOfConfusionRadiusPixels': float(scene.eevee.bokeh_max_size),
+        'nativeJitterEnabled': bool(scene.eevee.use_bokeh_jittered),
+        'candidateRejectionReasons': reasons,
+    }
diff --git a/packages/blender-addon/tests/camera_dof_optics_check.py b/packages/blender-addon/tests/camera_dof_optics_check.py
new file mode 100644
index 0000000..cd90b48
--- /dev/null
+++ b/packages/blender-addon/tests/camera_dof_optics_check.py
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""CPU-only extraction and projected-aperture oracle; never renders or saves."""
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+import bpy
+from mathutils import Vector
+
+root = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(root))
+from camera_fidelity import extract_depth_of_field
+
+original = Path(bpy.data.filepath) if bpy.data.filepath else None
+original_hash = hashlib.sha256(original.read_bytes()).hexdigest() if original else None
+original_inputs = extract_depth_of_field(bpy.context.scene) if original else None
+bpy.ops.wm.read_factory_settings(use_empty=False)
+scene = bpy.context.scene
+camera = scene.camera
+assert extract_depth_of_field(scene) is None
+camera.data.dof.use_dof = True
+camera.data.lens = 50
+camera.data.dof.aperture_fstop = 0.5
+camera.data.dof.focus_distance = 7
+camera.data.dof.aperture_blades = 0
+camera.data.dof.aperture_ratio = 1
+scene.eevee.use_bokeh_jittered = False
+scene.render.engine = 'BLENDER_EEVEE'
+scene.render.resolution_x = 1920
+scene.render.resolution_y = 1080
+scene.render.resolution_percentage = 100
+before = (camera.matrix_world.copy(), camera.data.lens, camera.data.dof.aperture_fstop,
+          camera.data.dof.focus_distance, scene.render.resolution_x, scene.render.resolution_y)
+data = extract_depth_of_field(scene)
+assert not data['candidateRejectionReasons']
+assert data['automaticEnabled'] is False and data['qualification'] == 'experimental-unqualified'
+assert abs(data['apertureRadiusBlenderUnits']-0.05) < 1e-9
+matrix = camera.calc_matrix_camera(bpy.context.evaluated_depsgraph_get(), x=1920, y=1080,
+                                  scale_x=1, scale_y=1)
+project = lambda v: matrix @ Vector((*v, 1))
+near_radii = []
+for depth in (0.1, 1, 2, 4, 7, 10, 100, 1e10):
+    focus = data['focusDistanceBlenderUnits']
+    center = project((0, 0, -focus))
+    jitter = project((0.05, 0, -focus))
+    bias = (jitter.x/jitter.w-center.x/center.w)*1280/2
+    native_madd = focus*bias/(-depth)+bias
+    analytic = data['apertureRadiusBlenderUnits']*data['projection'][0]*1280/(2*focus)*(1-focus/depth)
+    assert abs(native_madd-analytic) < 1e-4
+    near_radii.append({'depth': depth, 'projectedRadiusPixels': native_madd})
+assert before == (camera.matrix_world, camera.data.lens, camera.data.dof.aperture_fstop,
+                  camera.data.dof.focus_distance, scene.render.resolution_x, scene.render.resolution_y)
+# BKE_camera_object_dof_distance uses axial distance, not Euclidean distance.
+camera.matrix_world.identity()
+target = bpy.data.objects['Cube']
+target.location = (3, 4, -10)
+camera.data.dof.focus_object = target
+bpy.context.view_layer.update()
+focused = extract_depth_of_field(scene)
+assert abs(focused['focusDistanceBlenderUnits']-10) < 1e-5
+assert focused['focusObject'] == target.name and focused['candidateRejectionReasons']
+camera.data.dof.focus_object = None
+for property_name, value, expected in (
+    ('aperture_blades', 6, 'Polygonal'), ('aperture_ratio', 2, 'Anamorphic'),
+):
+    setattr(camera.data.dof, property_name, value)
+    assert any(expected in reason for reason in extract_depth_of_field(scene)['candidateRejectionReasons'])
+    setattr(camera.data.dof, property_name, 0 if property_name == 'aperture_blades' else 1)
+if original:
+    assert original_hash == hashlib.sha256(original.read_bytes()).hexdigest()
+report = {'nativeBuild': bpy.app.build_hash.decode(), 'nativeVersion': bpy.app.version_string,
+          'sourceSha256': original_hash, 'sourceUnchanged': True, 'renderAttempts': 0,
+          'saveCalls': 0, 'supportCredit': 0, 'sceneAcceptance': False,
+          'originalOptics': original_inputs, 'projectedApertureControls': near_radii}
+args = sys.argv[sys.argv.index('--')+1:] if '--' in sys.argv else []
+if args:
+    path = Path(args[0])
+    with path.open('x') as handle: handle.write(json.dumps(report, indent=2)+'\n')
+print('BLENDLINK_CAMERA_DOF_OPTICS_CPU_PASSED '+json.dumps(report))
