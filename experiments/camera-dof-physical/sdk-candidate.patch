index 0000000..b729e83
--- /dev/null
+++ b/packages/blendlink/src/sourceCameraDofCoverage.ts
@@ -0,0 +1,24 @@
+/** Conservative full-resolution foreground bounds, inspired by pinned EEVEE
+ * 8-half-resolution-pixel tiles (16 physical pixels) and radius-aware dilation.
+ * This is independent bounding metadata, not reduced-resolution color. */
+export const CAMERA_DOF_TILE_PIXELS = 16
+export const CAMERA_DOF_GATHER_RADIUS_ERROR = 1+1/5.5
+export function cameraDofTileExtent(width:number,height:number):readonly[number,number] {
+  if(!Number.isInteger(width)||!Number.isInteger(height)||width<=0||height<=0)
+    throw Error('Camera DOF bounds require a positive physical pixel extent')
+  return[Math.ceil(width/CAMERA_DOF_TILE_PIXELS),Math.ceil(height/CAMERA_DOF_TILE_PIXELS)]
+}
+/** CPU oracle for conservative native-style radius-aware bounds propagation. */
+export function cameraDofDilatedNearBound(radii:readonly number[],width:number,height:number,x:number,y:number,maximum:number):number {
+  if(radii.length!==width*height)throw Error('Camera DOF tile radius shape mismatch')
+  const reach=Math.ceil(maximum*CAMERA_DOF_GATHER_RADIUS_ERROR/CAMERA_DOF_TILE_PIXELS)
+  let result=0
+  for(let dy=-reach;dy<=reach;dy++)for(let dx=-reach;dx<=reach;dx++){
+    const sx=x+dx,sy=y+dy
+    if(sx<0||sy<0||sx>=width||sy>=height)continue
+    const radius=radii[sy*width+sx]
+    const distance=Math.hypot(Math.max(Math.abs(dx)-1,0),Math.max(Math.abs(dy)-1,0))*CAMERA_DOF_TILE_PIXELS
+    if(radius*CAMERA_DOF_GATHER_RADIUS_ERROR>distance)result=Math.max(result,radius)
+  }
+  return result
+}
