+ [-3.5,1,0,1,0,false],[-3,.5,0,1,0,false],[-2.5,0,0,1,0,false],
+ [-.500001,0,0,1,0,false],[-.5,0,0,1,0,true],[0,0,0,1,1,true],[.5,0,0,1,1,true],
+ [.500001,0,0,0,1,false],[2.5,0,0,0,1,false],[3,0,0,0,1,false],[3.5,0,.5,0,1,false],
+ [4,0,1,0,1,false],[4.5,0,1,0,.5,false],[5,0,1,0,0,false],[6,0,1,0,0,false],
+])('source full-pixel layer boundary %s',(radius,near,far,slightNear,slightFar,focused)=>{
+ const actual=cameraDofLayerWeights(radius as number)
+ expect([actual.foreground,actual.background,actual.slightForeground,actual.slightBackground,actual.focus])
+  .toEqual([near,far,slightNear,slightFar,focused])
+})
+it('uses a linear one-pixel disk-edge transition rather than a smoothstep curve',()=>{
+ expect(cameraDofDiskIntersection(-3,3.5)).toBe(0)
+ expect(cameraDofDiskIntersection(-3,3)).toBe(.5)
+ expect(cameraDofDiskIntersection(-3,2.75)).toBe(.75)
+ expect(cameraDofDiskIntersection(-3,2.5)).toBe(1)
