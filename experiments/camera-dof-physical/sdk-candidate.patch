@@ -0,0 +1,34 @@
+/** Independently expressed scalar layer equations from the pinned EEVEE
+ * contract. This is not a translation of its ring accumulator or resolve. */
+const saturate=(value:number)=>Math.max(0,Math.min(1,value))
+export function cameraDofLayerWeights(fullPixelRadius:number){
+  if(!Number.isFinite(fullPixelRadius))throw Error('Camera DOF layers require a finite full-pixel radius')
+  const absolute=Math.abs(fullPixelRadius),slight=saturate(5-absolute)
+  return{
+    foreground:saturate(-fullPixelRadius-2.5),
+    background:saturate(fullPixelRadius-3),
+    slightForeground:fullPixelRadius<=0.5?slight:0,
+    slightBackground:fullPixelRadius> -0.5?slight:0,
+    focus:absolute<=0.5,
+  }
+}
+export function cameraDofDiskIntersection(fullPixelRadius:number,distancePixels:number){
+  if(!Number.isFinite(fullPixelRadius)||!Number.isFinite(distancePixels)||distancePixels<0)
+    throw Error('Camera DOF disk intersection requires finite radius and nonnegative distance')
+  return saturate(Math.abs(fullPixelRadius)-distancePixels+0.5)
+}
+export interface CameraDofResolvedField {premultiplied:readonly number[];coverage:number}
+/** Independent premultiplied layer algebra, not native accumulation. A
+ * focused center is restored before slight/large foreground fields overlay. */
+export function resolveCameraDofLayerPixel(original:readonly number[],background:readonly number[],
+  slightBackground:CameraDofResolvedField,slightForeground:CameraDofResolvedField,
+  foreground:CameraDofResolvedField,fullPixelRadius:number):number[]{
+  const focused=cameraDofLayerWeights(fullPixelRadius).focus
+  const fields=[slightBackground,slightForeground,foreground]
+  if(!fields.every(field=>Number.isFinite(field.coverage)&&field.coverage>=0&&field.coverage<=1)
+    || [original,background,...fields.map(f=>f.premultiplied)].some(v=>v.length!==3||!v.every(Number.isFinite)))
+    throw Error('Camera DOF resolve requires finite RGB and normalized layer coverage')
+  const over=(field:CameraDofResolvedField,under:readonly number[])=>under.map((v,i)=>field.premultiplied[i]+v*(1-field.coverage))
+  const base=focused?[...original]:over(slightBackground,background)
+  return over(foreground,over(slightForeground,base))
+}
