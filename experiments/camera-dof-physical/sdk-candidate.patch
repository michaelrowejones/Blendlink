@@ -0,0 +1,77 @@
+import { describe, expect, it } from 'vitest'
+import * as THREE from 'three'
+import optics from '../../../experiments/camera-dof-physical/impact-optics.json'
+import { sourceCircleOfConfusionRadius, validateSourceCameraDof,
+  type SourceCameraDepthOfField } from './sourceCameraDof.js'
+import { validateSourceCameraDofScene } from './tslSourceCameraDof.js'
+
+const source = (): SourceCameraDepthOfField => structuredClone(optics.cameraDepthOfField) as SourceCameraDepthOfField
+function fixture() {
+  const data = source(), scene = new THREE.Scene()
+  const camera = new THREE.PerspectiveCamera(2*Math.atan(1/data.projection[5])*180/Math.PI,
+    data.renderExtent[0]/data.renderExtent[1], data.clipNear, data.clipFar)
+  camera.name = data.camera
+  camera.matrixAutoUpdate = false
+  camera.matrix.fromArray([...new THREE.Matrix4().set(...data.cameraWorldGltf as Parameters<THREE.Matrix4['set']>).elements])
+  const material = new THREE.MeshStandardMaterial()
+  scene.add(new THREE.Mesh(new THREE.BoxGeometry(),material))
+  return {data,scene,camera,material}
+}
+
+describe('source physical camera CoC candidate',()=>{
+  it('matches an independent projected-aperture oracle on native Impact inputs, near/focus/far/infinity and output scales',()=>{
+    const data=source()
+    validateSourceCameraDof(data)
+    // Independent homogeneous matrix projection of aperture and center at
+    // the focus plane, then native inverse-depth MADD, not the SDK equation.
+    const p=data.projection, focus=data.focusDistanceBlenderUnits
+    const project=(x:number,z:number)=>(p[0]*x+p[2]*z+p[3])/(p[12]*x+p[14]*z+p[15])
+    for(const width of [640,1280,1920]) for(const depth of [data.clipNear,1,2,4,focus,10,100,Infinity]) {
+      const bias=(project(data.lensMillimeters/2000/data.apertureFStop,-focus)-project(0,-focus))*width/2
+      const expected=Math.max(-100,Math.min(100,focus*bias*(-1/depth)+bias))
+      expect(sourceCircleOfConfusionRadius(data,depth,width)).toBeCloseTo(expected,10)
+    }
+    expect(sourceCircleOfConfusionRadius(data,focus,1280)).toBe(0)
+    expect(sourceCircleOfConfusionRadius(data,1,1280)).toBeLessThan(-70)
+    expect(sourceCircleOfConfusionRadius(data,Infinity,1280)).toBeGreaterThan(12)
+  })
+  it('obeys f-stop inverse scaling and focal plane location rather than an artistic smoothstep range',()=>{
+    const data=source(), stopped=source()
+    stopped.apertureFStop*=2;stopped.apertureRadiusBlenderUnits/=2
+    for(const depth of [2,4,10,100]) expect(sourceCircleOfConfusionRadius(stopped,depth,1280))
+      .toBeCloseTo(sourceCircleOfConfusionRadius(data,depth,1280)/2,10)
+    expect(()=>sourceCircleOfConfusionRadius(data,0,1280)).toThrow(/positive/)
+    expect(()=>sourceCircleOfConfusionRadius(data,NaN,1280)).toThrow(/positive/)
+  })
+  it.each([
+    ['build',(s:SourceCameraDepthOfField)=>s.nativeBuild='new-build'],
+    ['aperture',(s:SourceCameraDepthOfField)=>s.apertureFStop=4],
+    ['blades',(s:SourceCameraDepthOfField)=>s.apertureBlades=6],
+    ['ratio',(s:SourceCameraDepthOfField)=>s.apertureRatio=2],
+    ['focus object',(s:SourceCameraDepthOfField)=>s.focusObject='Target'],
+    ['jitter',(s:SourceCameraDepthOfField)=>s.nativeJitterEnabled=true],
+    ['exclusion',(s:SourceCameraDepthOfField)=>s.candidateRejectionReasons=['animated']],
+    ['NaN',(s:SourceCameraDepthOfField)=>s.focusDistanceBlenderUnits=NaN],
+    ['radius',(s:SourceCameraDepthOfField)=>s.maxCircleOfConfusionRadiusPixels=101],
+  ])('refuses tampered or out-of-contract %s',(_label,change)=>{
+    const data=source();change(data);expect(()=>validateSourceCameraDof(data)).toThrow(/Experimental Blender camera DOF/)
+  })
+  it('accepts matching camera and full physical extent at authored aspect',()=>{
+    const f=fixture()
+    expect(()=>validateSourceCameraDofScene(f.data,f.scene,f.camera,1280,720)).not.toThrow()
+    expect(()=>validateSourceCameraDofScene(f.data,f.scene,f.camera,1920,1080)).not.toThrow()
+  })
+  it.each(['identity','pose','projection','clip','aspect','transparent','transmission','depthWrite'])(
+    'refuses changed runtime %s',kind=>{
+      const f=fixture();let width=1280,height=720
+      if(kind==='identity')f.camera.name='foreign'
+      if(kind==='pose')f.camera.matrix.elements[12]+=1
+      if(kind==='projection')f.camera.projectionMatrix.elements[0]+=1
+      if(kind==='clip')f.camera.far=100
+      if(kind==='aspect')width=1000
+      if(kind==='transparent')f.material.transparent=true
+      if(kind==='transmission')(f.material as THREE.MeshPhysicalMaterial).transmission=1
+      if(kind==='depthWrite')f.material.depthWrite=false
+      expect(()=>validateSourceCameraDofScene(f.data,f.scene,f.camera,width,height)).toThrow(/Experimental Blender camera DOF/)
+    })
+})
diff --git a/packages/blendlink/src/sourceCameraDof.ts b/packages/blendlink/src/sourceCameraDof.ts
new file mode 100644
index 0000000..fe52ef9
--- /dev/null
+++ b/packages/blendlink/src/sourceCameraDof.ts
@@ -0,0 +1,97 @@
+/** Source-derived EEVEE perspective optics. This is not an EEVEE bokeh renderer. */
+export interface SourceCameraDepthOfField {
+  version: 1
+  model: 'eevee-perspective-coc-v1'
+  qualification: 'experimental-unqualified'
+  automaticEnabled: false
+  camera: string
+  frame: number
+  nativeVersion: readonly number[]
+  nativeBuild: string
+  cameraType: string
+  lensMillimeters: number
+  sensorFit: string
+  sensorWidthMillimeters: number
+  sensorHeightMillimeters: number
+  apertureFStop: number
+  apertureRadiusBlenderUnits: number
+  apertureBlades: number
+  apertureRotationRadians: number
+  apertureRatio: number
+  focusDistanceBlenderUnits: number
+  focusObject: string | null
+  focusBone: string
+  clipNear: number
+  clipFar: number
+  /** Native row-major projection and Y-up camera world transform. */
+  projection: readonly number[]
+  cameraWorldGltf: readonly number[]
+  renderExtent: readonly [number, number]
+  pixelAspect: readonly [number, number]
+  maxCircleOfConfusionRadiusPixels: number
+  nativeJitterEnabled: boolean
+  candidateRejectionReasons: readonly string[]
+}
+
+export const SOURCE_CAMERA_DOF_SAMPLING = Object.freeze({
+  model: 'experimental-physical-coc-layer-resolve-v3',
+  backgroundDiskSamples: 64,
+  foregroundDiskSamples: 128,
+  centerSamples: 1,
+  slightFocusDiskPairs: 16,
+  slightFocusMaximumSearchRadiusPixels: 5,
+  nativeRingOcclusion: false,
+  colorTextureReads: 225,
+  depthTextureReads: 225,
+  resolutionScale: 1,
+  foregroundBoundsTilePhysicalPixels: 16,
+  foregroundBoundsDepthReadsPerTile: 256,
+  foregroundBoundsDilationReadsPerTileAt100PixelCap: 289,
+  eeveeGatherScatterParity: false,
+})
+
+export function validateSourceCameraDof(source: SourceCameraDepthOfField): void {
+  const fail = (reason: string): never => { throw new Error(`Experimental Blender camera DOF: ${reason}.`) }
+  if (source.version !== 1 || source.model !== 'eevee-perspective-coc-v1'
+    || source.qualification !== 'experimental-unqualified' || source.automaticEnabled !== false)
+    fail('unsupported optics contract')
+  if (source.nativeVersion?.join('.') !== '5.3.0' || source.nativeBuild !== '02f0899d78e3')
+    fail('native source model is pinned to Blender 5.3.0 build 02f0899d78e3')
+  if (source.cameraType !== 'PERSP' || source.apertureBlades !== 0 || source.apertureRatio !== 1
+    || source.focusObject !== null || source.focusBone !== '' || source.nativeJitterEnabled !== false) fail('only static perspective distance focus and a circular aperture are in scope')
+  if (!Array.isArray(source.candidateRejectionReasons) || source.candidateRejectionReasons.length)
+    fail(`source optics are outside the bounded candidate (${source.candidateRejectionReasons?.join('; ')})`)
+  for (const value of [source.lensMillimeters, source.apertureFStop, source.apertureRadiusBlenderUnits,
+    source.focusDistanceBlenderUnits, source.clipNear, source.clipFar, source.maxCircleOfConfusionRadiusPixels])
+    if (!Number.isFinite(value) || value <= 0) fail('nonpositive or nonfinite optical parameter')
+  if (source.clipFar <= source.clipNear || source.maxCircleOfConfusionRadiusPixels > 100)
+    fail('clip range or native maximum radius exceeds the bounded 100 pixel candidate')
+  const aperture = source.lensMillimeters * 0.001 / (2 * Math.max(source.apertureFStop, 1e-5))
+  if (Math.abs(aperture-source.apertureRadiusBlenderUnits) > aperture*1e-6)
+    fail('lens/f-stop and transported aperture disagree')
+  for (const matrix of [source.projection, source.cameraWorldGltf])
+    if (!Array.isArray(matrix) || matrix.length !== 16 || !matrix.every(Number.isFinite)) fail('invalid camera matrix')
+  if (source.projection[0] <= 0 || source.projection[5] <= 0
+    || source.projection[14] !== -1 || source.projection[15] !== 0) fail('invalid perspective projection')
+  if (source.renderExtent?.length !== 2 || !source.renderExtent.every(v=>Number.isInteger(v)&&v>0)
+    || source.pixelAspect?.length !== 2 || source.pixelAspect[0] !== source.pixelAspect[1]
+    || !source.pixelAspect.every(v=>Number.isFinite(v)&&v>0)) fail('invalid output extent or nonsquare pixels')
+  if (!Number.isFinite(source.apertureRotationRadians) || !Number.isFinite(source.frame)
+    || typeof source.camera !== 'string' || !source.camera) fail('invalid camera identity')
+}
+
+/** EEVEE full-aperture signed radius in physical output pixels; near is negative.
+ * This is the total optical footprint, not EEVEE's jitter/post split radius.
+ * Native EEVEE projects an aperture offset at the focus plane and reduces it to
+ * coc_mul/viewZ + coc_bias (eevee_depth_of_field.cc render(), shared.hh).
+ */
+export function sourceCircleOfConfusionRadius(
+  source: SourceCameraDepthOfField, positiveViewDepth: number, outputWidth: number,
+): number {
+  if (!(positiveViewDepth > 0) || !Number.isFinite(outputWidth) || outputWidth <= 0)
+    throw new Error('Camera CoC requires positive camera-axis depth and output width.')
+  const bias = source.apertureRadiusBlenderUnits * source.projection[0] * outputWidth
+    / (2 * source.focusDistanceBlenderUnits)
+  const radius = bias * (1-source.focusDistanceBlenderUnits/positiveViewDepth)
+  return Math.max(-source.maxCircleOfConfusionRadiusPixels, Math.min(source.maxCircleOfConfusionRadiusPixels, radius))
+}
