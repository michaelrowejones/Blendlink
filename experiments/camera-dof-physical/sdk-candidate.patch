+import {expect,it} from 'vitest'
+import {cameraDofTileExtent,cameraDofDilatedNearBound} from './sourceCameraDofCoverage.js'
+
+it('retains every edge tile without reducing the physical color extent',()=>{
+  expect(cameraDofTileExtent(1280,720)).toEqual([80,45])
+  expect(cameraDofTileExtent(1281,721)).toEqual([81,46])
+  expect(()=>cameraDofTileExtent(0,720)).toThrow(/physical/)
+})
+it('propagates nearby negative-CoC coverage to an in-focus background tile',()=>{
+  const radii=[0,20,0,0,0]
+  expect(cameraDofDilatedNearBound(radii,5,1,0,0,100)).toBe(20)
+  expect(cameraDofDilatedNearBound(radii,5,1,2,0,100)).toBe(20)
+  // Two-tile separation is conservatively 16 pixels; four is 48.
+  expect(cameraDofDilatedNearBound(radii,5,1,3,0,100)).toBe(20)
+  expect(cameraDofDilatedNearBound(radii,5,1,4,0,100)).toBe(0)
+})
+it('keeps the largest intersecting disk rather than distant unrelated foreground',()=>{
+  const radii=Array(15).fill(0);radii[1]=5;radii[14]=100
+  expect(cameraDofDilatedNearBound(radii,15,1,0,0,100)).toBe(5)
+  expect(cameraDofDilatedNearBound(radii,15,1,8,0,100)).toBe(100)
+  expect(cameraDofDilatedNearBound(Array(9).fill(0),3,3,1,1,100)).toBe(0)
+})
diff --git a/packages/blendlink/src/sourceCameraDofCoverage.ts b/packages/blendlink/src/sourceCameraDofCoverage.ts
