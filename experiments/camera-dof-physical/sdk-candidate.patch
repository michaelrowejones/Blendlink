+ const slightNear={premultiplied:[0,.25,0],coverage:.25}
+ expect(resolveCameraDofLayerPixel([1,0,0],[0,0,1],slightBg,slightNear,none,.5)).toEqual([.75,.25,0])
+ const largeNear={premultiplied:[.25,0,0],coverage:.25},halfBg={premultiplied:[0,.5,0],coverage:.5}
+ expect(resolveCameraDofLayerPixel([1,0,0],[0,0,1],halfBg,none,largeNear,3)).toEqual([.25,.375,.375])
